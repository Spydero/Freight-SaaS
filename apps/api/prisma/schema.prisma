generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPS
  CLIENT
}

enum FreightMode {
  OCEAN
  RAIL
  ROAD
  AIR
  MULTIMODAL
}

enum ShipmentStatus {
  BOOKED
  IN_TRANSIT
  AT_CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  REVISION_REQUESTED
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  QUOTED
  CLOSED
}

enum DocumentType {
  BOL
  COMMERCIAL_INVOICE
  PACKING_LIST
  CUSTOMS
  OTHER
}

enum PortType {
  PORT
  AIRPORT
  CITY
}

enum ServiceCategory {
  MODE
  VAS
}

enum OrgApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  billingEmail   String?
  approvalStatus OrgApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  approvedById   String?
  rejectionReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  members       Membership[]
  quoteRequests QuoteRequest[]
  quotes        Quote[]
  shipments     Shipment[]
  activityLogs  ActivityLog[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       Membership[]
  createdQuotes     Quote[]            @relation("QuoteCreator")
  assignedShipments Shipment[]         @relation("ShipmentAssignee")
  events            ShipmentEvent[]
  comments          ShipmentComment[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Service {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  category    ServiceCategory
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)

  quoteRequests QuoteRequest[]
}

model Port {
  id      String   @id @default(cuid())
  code    String   @unique
  name    String
  country String
  type    PortType

  originShipments      Shipment[] @relation("OriginPort")
  destinationShipments Shipment[] @relation("DestinationPort")
}

model QuoteRequest {
  id             String     @id @default(cuid())
  organizationId String?
  contactName    String
  companyName    String
  email          String
  destination    String
  message        String?
  status         LeadStatus @default(NEW)
  serviceId      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  quotes       Quote[]

  @@index([status, createdAt])
  @@index([organizationId, status])
}

model Quote {
  id              String      @id @default(cuid())
  organizationId  String
  quoteRequestId  String?
  status          QuoteStatus @default(DRAFT)
  currency        String      @default("USD")
  validUntil      DateTime
  notes           String?
  total           Decimal     @db.Decimal(12, 2)
  mode            FreightMode @default(OCEAN)
  originLabel     String?
  destinationLabel String?
  weightKg        Float?
  packageCount    Int?
  containerCount  Int?
  commodity       String?
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  quoteRequest QuoteRequest?   @relation(fields: [quoteRequestId], references: [id])
  createdBy    User            @relation("QuoteCreator", fields: [createdById], references: [id])
  lineItems    QuoteLineItem[]
  shipment     Shipment?

  @@index([organizationId, status])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  description String
  quantity    Float
  unitPrice   Decimal @db.Decimal(12, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                String         @id @default(cuid())
  organizationId    String
  quoteId           String?        @unique
  referenceCode     String
  mode              FreightMode
  status            ShipmentStatus @default(BOOKED)
  originLabel       String
  destinationLabel  String
  originPortId      String?
  destinationPortId String?
  etd               DateTime?
  eta               DateTime?
  weightKg          Float?
  packageCount      Int?
  containerCount    Int?
  commodity         String?
  holdReason        String?
  assigneeId        String?
  trackingTokenHash String         @unique
  trackingTokenHint String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  quote           Quote?            @relation(fields: [quoteId], references: [id])
  originPort      Port?             @relation("OriginPort", fields: [originPortId], references: [id])
  destinationPort Port?             @relation("DestinationPort", fields: [destinationPortId], references: [id])
  assignee        User?             @relation("ShipmentAssignee", fields: [assigneeId], references: [id])
  events          ShipmentEvent[]
  comments        ShipmentComment[]
  documents       Document[]

  @@unique([organizationId, referenceCode])
  @@index([organizationId, status])
  @@index([status])
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  title       String
  description String?
  location    String?
  occurredAt  DateTime
  createdById String?
  createdAt   DateTime @default(now())

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([shipmentId, occurredAt])
}

model ShipmentComment {
  id         String   @id @default(cuid())
  shipmentId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([shipmentId, createdAt])
}

model Document {
  id         String       @id @default(cuid())
  shipmentId String
  name       String
  type       DocumentType @default(OTHER)
  mimeType   String
  storageKey String
  sizeBytes  Int?
  uploadedAt DateTime     @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String
  meta           Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
}

model TeamMember {
  id        String  @id @default(cuid())
  name      String
  title     String
  photoUrl  String?
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model Testimonial {
  id         String  @id @default(cuid())
  quote      String
  authorName String
  authorTitle String
  photoUrl   String?
  published  Boolean @default(true)
  sortOrder  Int     @default(0)
}
